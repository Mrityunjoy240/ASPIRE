# Copy this file to database/config/.env and fill in local values.
# database/config/.env is git-ignored. Never commit a real credential.
#
# Development database used for migrations and tests.
DATABASE_URL=postgresql://bcrec:CHANGE_ME@localhost:5432/bcrec_central
#
# Maintenance connection used by tests to create and drop the dedicated
# test database. It must point at an existing database on the same cluster.
BCREC_MAINTENANCE_URL=postgresql://bcrec:CHANGE_ME@localhost:5432/postgres
#
# Development-only password applied to login roles by:
#   python database/migrate.py provision-dev-roles
# Production role passwords are provisioned by the DBA and never stored here.
BCREC_ROLE_PASSWORD=CHANGE_ME
