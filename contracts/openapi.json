    "/api/v1/cases/{case_id}/approve": {
      "post": {
        "tags": [
          "Intervention Cases"
        ],
        "summary": "Mentor human-in-the-loop approval",
        "description": "Mentor approves/edits/rejects intervention plan.\n\nTransition ownership, plan selection and event emission live in the Case\nApproval Service (03_SYSTEM_SPEC §10.2, ADR-002): audit row + commit, then\nINTERVENTION_PLAN_APPROVED for approval decisions only.",
        "operationId": "approve_case_api_v1_cases__case_id__approve_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseApproveRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseApproveResponse"
                }
              }
            }
          },
          "409": {
            "description": "Case not in PENDING_APPROVAL, or multiple plans await a mentor decision (03_SYSTEM_SPEC §10.2)"
          },
          "400": {
            "description": "No plan awaiting mentor decision for this case"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cases/{case_id}/student-decision": {
      "post": {
        "tags": [
          "Intervention Cases"
        ],
        "summary": "Student accepts, customizes or declines the proposed plan",
        "description": "Student accepts, customizes or declines the agent-proposed plan.\n\nTransition ownership, plan selection, audit row and PLAN_ACCEPTED /\nPLAN_DECLINED emission live in the Student Action Service\n(03_SYSTEM_SPEC §10.2, §8.2). Decline reason is optional\n(02_USER_JOURNEYS 1.1 Step 6).",
        "operationId": "student_plan_decision_api_v1_cases__case_id__student_decision_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StudentDecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentDecisionResponse"
                }
              }
            }
          },
          "409": {
            "description": "Case not in PLAN_PROPOSED, or multiple proposed plans await a student decision (03_SYSTEM_SPEC §10.2)"
          },
          "400": {
            "description": "No proposed plan awaiting a student decision for this case"
          },
          "403": {
            "description": "Case does not belong to the authenticated student"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
