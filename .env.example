# ASPIRE environment template.
# Copy to .env.local (gitignored) and fill values. NEVER commit real secrets (Constitution S-05).

# --- Database (PostgreSQL / Supabase) ---
DATABASE_URL=

# --- LLM service (DM-LLM01: Agent -> LLMService -> OpenRouter) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Embeddings (RAG / Learning Workspace) ---
EMBEDDING_MODEL=

# --- Supabase (FROZEN names — legacy SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are forbidden) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URI=

# --- Supabase JWT validation (07 §1): explicit aud/iss — never the publishable key ---
# SUPABASE_JWT_AUDIENCE default: authenticated (Supabase access-token audience)
SUPABASE_JWT_AUDIENCE=
# SUPABASE_JWT_ISSUER default (empty): {NEXT_PUBLIC_SUPABASE_URL}/auth/v1
SUPABASE_JWT_ISSUER=
